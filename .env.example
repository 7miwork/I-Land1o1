# ============================================================
# I-Land1o1 – Umgebungsvariablen (VORLAGE)
# ============================================================
# Diese Datei ist nur die Vorlage. Kopieren & lokal ausfüllen:
#   Copy-Item .env.example .env
# .env ist in .gitignore und wird NIEMALS committet.
#
# WICHTIG: Es gibt zwei Sorten von Variablen!
#  A) Browser/Frontend (darf im Repo stehen, ist "öffentlich")
#  B) Server (NUR in Supabase Edge Functions -> Secrets, NIEMALS im Frontend!)
# ============================================================


# ------------------------------------------------------------
# A) SUPABASE – Frontend (harmlos, steht bereits in dashboard/config.js)
# ------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://lmlbjtazgcylsrtzzisr.supabase.co
# PLATZHALTER – echte Werte NIE ins Git (liegen lokal in .env / supabase/.env.local)!
SUPABASE_ANON_KEY=<anon-key-aus-project-settings-api>


# ------------------------------------------------------------
# B) SUPABASE – Server (Secrets!)
# ------------------------------------------------------------
# Project Settings -> API  (NUR fuer Edge Functions/Server verwenden!)
# PLATZHALTER – echten Key lokal eintragen. ACHTUNG: Dieser Key lag im
# Git-Verlauf und MUSS rotiert werden (Dashboard -> API keys neu erzeugen,
# danach auch in Supabase -> Edge Functions -> Secrets neu setzen)!
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-aus-project-settings-api>


# ------------------------------------------------------------
# C) STRIPE – NUR als Edge-Function-Secret
# ------------------------------------------------------------
# https://dashboard.stripe.com/test/apikeys
# LANGER Schluessel sk_test_...  -> darf NIEMALS im Browser landen
# PLATZHALTER – sk_live_ lag im Git-Verlauf und MUSS rotiert werden!
# (Unter Dashboard -> API keys neu erzeugen und dann auch in Supabase ->
#  Edge Functions -> STRIPE_SECRET_KEY neu setzen.)
STRIPE_SECRET_KEY=sk_test_<hier-eintragen>

# https://dashboard.stripe.com/test/webhooks
# Nach dem Anlegen des Webhooks (URL siehe functions/README.md)
# whsec_ ggf. ebenfalls neu erzeugen (lag ebenfalls im Verlauf).
STRIPE_WEBHOOK_SECRET=whsec_<hier-eintragen>


# ------------------------------------------------------------
# D) PREISE – Preis-IDs aus dem Stripe-Dashboard
# ------------------------------------------------------------
# Stripe -> Products -> dein Produkt -> "Pricing" -> Preis-ID (price_...)
# Diese IDs sind öffentlich, stehen aber besser als Secret in Supabase.
STRIPE_PRICE_LEVEL1_MONTHLY=price_99
STRIPE_PRICE_LEVEL1_YEARLY=price_1199
STRIPE_PRICE_LEVEL1_ONCE=price_499

# ------------------------------------------------------------
# E) WEBSITE
# ------------------------------------------------------------
# Basis-URL fuer Ruecklinks aus Stripe (Checkout success/cancel)
SITE_URL=https://i-land1o1.com


# ------------------------------------------------------------
# F) OPTIONAL: E-Mail (Rueckmeldungen, Spaeter wichtig)
# ------------------------------------------------------------
# Supabase -> Project Settings -> Auth -> SMTP
# Hostinger SMTP: smtp.hostinger.com, Port 465, User = vollstaendige Email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=I-Land1o1 <noreply@i-land1o1.com>